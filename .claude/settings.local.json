{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(go doc *)",
      "mcp__gomcp__list_packages",
      "mcp__gomcp__list_files",
      "mcp__gomcp__list_methods",
      "mcp__gomcp__list_symbols",
      "mcp__gomcp__describe_package",
      "mcp__gomcp__describe_file",
      "mcp__gomcp__describe_symbol",
      "mcp__gomcp__search_declarations_like",
      "mcp__gomcp__search_source",
      "mcp__gomcp__search_implementors",
      "mcp__gomcp__search_references",
      "mcp__gomcp__diagnostics",
      "mcp__gomcp__create_package",
      "mcp__gomcp__create_file",
      "mcp__gomcp__create_symbol",
      "mcp__gomcp__edit_symbol",
      "mcp__gomcp__edit_file",
      "mcp__gomcp__delete_symbol",
      "mcp__gomcp__delete_file",
      "mcp__gomcp__delete_package",
      "mcp__gomcp__move_symbol",
      "mcp__gomcp__move_file",
      "mcp__gomcp__move_package",
      "mcp__gomcp__flush",
      "mcp__gomcp__reload"
    ],
    "ask": [
      "Edit(**/*.go)",
      "Read(**/*.go)"
    ]
  },
  "enabledMcpjsonServers": [
    "gomcp"
  ]
}
